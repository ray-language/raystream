// Comprobador de la bitácora: ejecuta el repro mínimo de cada hallazgo de NOTES-raylang.md
// contra la versión de raylang instalada y dice cuáles siguen en pie.
//
//   ray run findings/check.ray                       # todos
//   ray run findings/check.ray -- /ruta/a/llms.txt   # y además los de documentación (7, 17)
//
// Estados: OK (resuelto y verificado) · ABIERTO (el repro sigue fallando) · REGRESIÓN (estaba
// resuelto y ha vuelto) · DECISIÓN (fuera por decisión del proyecto raylang) · MEDIR (hallazgo de
// rendimiento: lo cuantifica `bench/`, no un sí/no) · FUERA (necesita algo que este proyecto no usa).
import std/fs;
import std/process;

// Dónde viven los repros, relativo a la raíz del proyecto.
const REPRO: string = "findings/repro";

/// One line of the report.
struct Row {
    id: int,
    title: string,
    status: string,
    detail: string,
}

/// What a `ray` invocation produced.
struct Run {
    code: int,
    out: string,
    err: string,
}

fn main() -> int {
    let argv: [string] = args();
    let llms: string = if (argv.len() > 0) { argv[0] } else { "" };
    let tmp: string = fs.make_temp_dir("raystream_check").unwrap_or("/tmp");

    print("raystream · comprobación de hallazgos · ${ray_version()}");
    print("");
    var rows: [Row] = [];
    rows.push(check_run(1, "pub fn get rompía std/json", "f01_get.ray", "7"));
    rows = rows + net_checks();
    rows.push(
        Row {
            id: 4,
            title: "web sin salida a streaming",
            status: "FUERA",
            detail: "necesita el paquete web; raystream no lo usa"
        }
    );
    rows.push(check_closure(tmp));
    rows.push(check_lib_module());
    rows.push(check_doc(7, "llms.txt sin tipos de retorno", llms, "`b[i] -> int`"));
    rows.push(check_prelude_trait());
    rows.push(check_jpeg());
    rows.push(
        Row {
            id: 10,
            title: "procesado de imagen lento en la VM",
            status: "MEDIR",
            detail: "bench/pixel_loop.ray (VM frente a nativo)"
        }
    );
    rows.push(
        check_native_run(11, "assert_eq de enum derivado en nativo", "f11_eq.ray", "eq-ok", tmp)
    );
    rows.push(check_run(12, "to_string sobre Show", "f12_tostring.ray", "Route.Home"));
    rows.push(check_stubs(tmp));
    rows.push(check_fmt_keeps(14, "ray fmt recortaba el hex", "f14_hex.ray", "0x0D, 0x0A"));
    rows.push(check_run(15, "const sin arrays", "f15_const.ray", "vtt"));
    rows.push(check_run(16, "derive(Show) con campos array", "f16_show.ray", "tracks: [Track"));
    rows.push(
        check_doc(17, "char_from_code mal documentado", llms, "char_from_code(n) -> Option<char>")
    );
    rows.push(
        Row {
            id: 19,
            title: "bytes cruzando un canal: 1,8x",
            status: "MEDIR",
            detail: "bench/fiber_cost.ray (canal frente a retener)"
        }
    );
    rows.push(check_profiler(tmp));
    rows.push(check_native_build(21, "import std/sort rompía el nativo", "f21_sort.ray", tmp));
    rows.push(check_fmt_idempotent(tmp));

    print_table(sort_rows(rows));
    fs.remove_all(tmp).unwrap_or(0);
    0
}

// --- Las comprobaciones -------------------------------------------------------------------

// `ray run` del repro y su salida debe contener `expect`.
fn check_run(id: int, title: string, file: string, expect: string) -> Row {
    let r: Run = ray(["run", "${REPRO}/${file}"]);
    if (r.code == 0 && r.out.contains(expect)) {
        Row { id: id, title: title, status: "OK", detail: "ray run: ${first_line(r.out)}" }
    } else {
        Row { id: id, title: title, status: "ABIERTO", detail: first_line(r.err + r.out) }
    }
}

// Compila a nativo y ejecuta el binario.
fn check_native_run(id: int, title: string, file: string, expect: string, tmp: string) -> Row {
    let bin: string = "${tmp}/f${id}";
    let b: Run = ray(["build", "--native", "${REPRO}/${file}", "-o", bin]);
    if (b.code != 0) {
        return Row { id: id, title: title, status: "ABIERTO", detail: "build: " + first_error(b) };
    }
    match (process.run(bin, [])) {
        Result.Err(e) => Row { id: id, title: title, status: "ABIERTO", detail: e },
        Result.Ok(out) => {
            let text: string = from_utf8(out.stdout).unwrap_or("");
            if (text.contains(expect)) {
                Row {
                    id: id,
                    title: title,
                    status: "OK",
                    detail: "binario nativo: ${first_line(text)}"
                }
            } else {
                Row { id: id, title: title, status: "ABIERTO", detail: first_line(text) }
            }
        },
    }
}

fn check_native_build(id: int, title: string, file: string, tmp: string) -> Row {
    let b: Run = ray(["build", "--native", "${REPRO}/${file}", "-o", "${tmp}/f${id}"]);
    if (b.code == 0) {
        Row { id: id, title: title, status: "OK", detail: "ray build --native compila" }
    } else {
        Row { id: id, title: title, status: "ABIERTO", detail: first_error(b) }
    }
}

// [2] [3] [18] [23]: un programa que inspecciona las respuestas del paquete `net`.
fn net_checks() -> [Row] {
    let r: Run = ray(["run", "${REPRO}/f_net.ray"]);
    let out: string = r.out;
    [
        verdict(
            2,
            "static_mount leía el fichero entero",
            out,
            "2:lazy",
            "Range de 11 octetos sin cargar el fichero"
        ),
        verdict(
            3,
            "streaming sin Content-Length",
            out,
            "3:content-length-11",
            "stream_response_len anuncia Content-Length"
        ),
        verdict(
            18,
            "serve_file bufferizaba 1 MB por conexión",
            out,
            "18:filebody",
            "FileBody: el emisor lee, sin fibra ni canal"
        ),
        verdict(
            23,
            "send_response no sabía de HEAD",
            out,
            "23:send_response_for",
            "existe send_response_for(req, conn, r)"
        )
    ]
}

fn verdict(id: int, title: string, out: string, expect: string, ok_detail: string) -> Row {
    if (out.contains(expect)) {
        Row { id: id, title: title, status: "OK", detail: ok_detail }
    } else {
        Row { id: id, title: title, status: "ABIERTO", detail: line_for(out, "${id}:") }
    }
}

// [5]: el caso prohibido debe rechazarlo raylang, con su mensaje, antes de llegar a rustc.
fn check_closure(tmp: string) -> Row {
    let title: string = "handler con estado no compilaba a nativo";
    let b: Run = ray(["build", "--native", "${REPRO}/f05_closure.ray", "-o", "${tmp}/f5"]);
    let text: string = b.err + b.out;
    if (b.code != 0 && text.contains("closure stored in a variable") && !text.contains("error[E")) {
        Row {
            id: 5,
            title: title,
            status: "OK",
            detail: "error de raylang, sin rustc; alternativa: serve_raw_with"
        }
    } else if (text.contains("error[E")) {
        Row { id: 5, title: title, status: "REGRESIÓN", detail: "vuelven los errores de rustc" }
    } else {
        Row { id: 5, title: title, status: "ABIERTO", detail: first_line(text) }
    }
}

// [6]: `ray check` sobre un módulo sin `main`.
fn check_lib_module() -> Row {
    let r: Run = ray(["check", "${REPRO}/f06_lib.ray"]);
    let title: string = "ray check exigía main";
    if (r.code == 0) {
        Row { id: 6, title: title, status: "OK", detail: first_line(r.out) }
    } else {
        Row { id: 6, title: title, status: "ABIERTO", detail: first_line(r.err) }
    }
}

// [8]: el error debe señalar el fichero del usuario, en su línea real, con un mensaje claro.
fn check_prelude_trait() -> Row {
    let r: Run = ray(["check", "${REPRO}/f08_sub.ray"]);
    let text: string = r.err + r.out;
    let title: string = "trait del prelude: posición inventada";
    if (r.code != 0 && text.contains("at 2:") && text.contains("prelude trait")) {
        Row { id: 8, title: title, status: "OK", detail: line_for(text, "prelude trait") }
    } else {
        Row { id: 8, title: title, status: "ABIERTO", detail: first_line(text) }
    }
}

// [9]: fuera por decisión. Si algún día `std/image` decodifica JPEG, el repro compilará.
fn check_jpeg() -> Row {
    let r: Run = ray(["check", "${REPRO}/f09_jpeg.ray"]);
    let title: string = "std/image sólo decodifica PNG";
    if (r.code == 0) {
        Row { id: 9, title: title, status: "OK", detail: "std/image ya tiene decode_jpeg" }
    } else {
        Row {
            id: 9,
            title: title,
            status: "DECISIÓN",
            detail: "fuera de std; si llega, librería Tier-2"
        }
    }
}

// [13]: el binario nativo del proyecto entero no debe llevar stubs que revienten.
fn check_stubs(tmp: string) -> Row {
    let b: Run = ray(["build", "--native", "-o", "${tmp}/raystream"]);
    let text: string = b.err + b.out;
    let title: string = "stubs que revientan en nativo";
    if (b.code == 0 && !text.contains("stubs that panic")) {
        Row { id: 13, title: title, status: "OK", detail: "el proyecto compila a nativo sin stubs" }
    } else if (b.code != 0) {
        Row { id: 13, title: title, status: "ABIERTO", detail: first_error(b) }
    } else {
        Row { id: 13, title: title, status: "ABIERTO", detail: line_for(text, "stubs") }
    }
}

// [14]: `ray fmt` debe conservar un fragmento concreto.
fn check_fmt_keeps(id: int, title: string, file: string, keep: string) -> Row {
    let r: Run = ray(["fmt", "${REPRO}/${file}"]);
    if (r.code == 0 && r.out.contains(keep)) {
        Row { id: id, title: title, status: "OK", detail: "se conserva `${keep}`" }
    } else {
        Row { id: id, title: title, status: "ABIERTO", detail: line_for(r.out, "0x") }
    }
}

// [22]: formatear tres veces una copia debe dejarla igual que el original.
fn check_fmt_idempotent(tmp: string) -> Row {
    let title: string = "ray fmt corrompía interpolaciones anidadas";
    let copy: string = "${tmp}/f22.ray";
    let original: string = fs.read_file("${REPRO}/f22_fmt.ray").unwrap_or("");
    fs.write_file(copy, original).unwrap_or(0);
    var pass: int = 0;
    while (pass < 3) {
        ray(["fmt", "-w", copy]);
        pass = pass + 1;
    }
    let after: string = fs.read_file(copy).unwrap_or("");
    if (after == original) {
        Row {
            id: 22,
            title: title,
            status: "OK",
            detail: "3 pasadas de fmt -w: el fichero no cambia"
        }
    } else {
        Row {
            id: 22,
            title: title,
            status: "ABIERTO",
            detail: "crece a ${after.len()} caracteres (era ${original.len()})"
        }
    }
}

// [20]: ¿mide ya memoria el perfilador? Se miran las claves del JSON que produce.
fn check_profiler(tmp: string) -> Row {
    let out: string = "${tmp}/profile.json";
    ray(["profile", "--json", "--out", out, "bench/fiber_cost.ray", "--", "channel", "4", "0"]);
    let text: string = fs.read_file(out).unwrap_or("");
    let title: string = "el perfilador no mide memoria";
    if (text == "") {
        Row {
            id: 20,
            title: title,
            status: "ABIERTO",
            detail: "ray profile no escribió el informe"
        }
    } else if (text.contains("alloc") || text.contains("bytes") || text.contains("heap")) {
        Row { id: 20, title: title, status: "OK", detail: "el informe trae columnas de memoria" }
    } else {
        Row {
            id: 20,
            title: title,
            status: "EN DISEÑO",
            detail: "el JSON sólo trae tiempo y llamadas"
        }
    }
}

// [7] [17]: los de documentación necesitan `llms.txt` (se pasa como argumento).
fn check_doc(id: int, title: string, llms: string, expect: string) -> Row {
    if (llms == "") {
        return Row {
            id: id,
            title: title,
            status: "FUERA",
            detail: "pasa la ruta de llms.txt como argumento"
        };
    }
    match (fs.read_file(llms)) {
        Result.Err(e) => Row { id: id, title: title, status: "FUERA", detail: e },
        Result.Ok(text) => {
            if (text.contains(expect)) {
                Row { id: id, title: title, status: "OK", detail: "llms.txt: ${expect}" }
            } else {
                Row {
                    id: id,
                    title: title,
                    status: "ABIERTO",
                    detail: "llms.txt no dice `${expect}`"
                }
            }
        },
    }
}

// --- Utilidades ---------------------------------------------------------------------------

fn ray(argv: [string]) -> Run {
    match (process.run("ray", argv)) {
        Result.Err(e) => Run { code: 127, out: "", err: e },
        Result.Ok(o) => {
            let code: int = match (o.exit) {
                process.Exit.Code(n) => n,
                process.Exit.Signal(s) => 128 + s,
            };
            Run {
                code: code,
                out: from_utf8(o.stdout).unwrap_or(""),
                err: from_utf8(o.stderr).unwrap_or("")
            }
        },
    }
}

fn ray_version() -> string {
    first_line(ray(["version"]).out)
}

fn first_line(text: string) -> string {
    let lines: [string] = text.trim().split("\n");
    if (lines.len() == 0) { "" } else { clip(lines[0].trim(), 70) }
}

// La primera línea de error (de raylang o de rustc) de una compilación fallida.
fn first_error(r: Run) -> string {
    let text: string = r.err + r.out;
    let lines: [string] = text.split("\n");
    var i: int = 0;
    while (i < lines.len()) {
        let l: string = lines[i].trim();
        if (l.starts_with("error") || l.contains(" error at ")) {
            return clip(l, 70);
        }
        i = i + 1;
    }
    first_line(text)
}

fn line_for(text: string, needle: string) -> string {
    let lines: [string] = text.split("\n");
    var i: int = 0;
    while (i < lines.len()) {
        if (lines[i].contains(needle)) {
            return clip(lines[i].trim(), 70);
        }
        i = i + 1;
    }
    "(sin salida)"
}

fn clip(s: string, n: int) -> string {
    if (s.len() <= n) { s } else { s.substring(0, n - 1) + "…" }
}

// Orden por número de hallazgo (inserción: son ~20 filas).
fn sort_rows(rows: [Row]) -> [Row] {
    var out: [Row] = [];
    var i: int = 0;
    while (i < rows.len()) {
        let r: Row = rows[i];
        var pos: int = out.len();
        var j: int = 0;
        while (j < out.len()) {
            if (r.id < out[j].id) {
                pos = j;
                j = out.len();
            } else {
                j = j + 1;
            }
        }
        var next: [Row] = [];
        var k: int = 0;
        while (k < out.len()) {
            if (k == pos) {
                next.push(r);
            }
            next.push(out[k]);
            k = k + 1;
        }
        if (pos == out.len()) {
            next.push(r);
        }
        out = next;
        i = i + 1;
    }
    out
}

fn print_table(rows: [Row]) {
    var ok: int = 0;
    var open: int = 0;
    var i: int = 0;
    while (i < rows.len()) {
        let r: Row = rows[i];
        print(
            "[${pad_left(to_string(r.id), 2)}] ${pad_right(r.status, 10)} ${pad_right(r.title, 44)} ${r.detail}"
        );
        if (r.status == "OK") {
            ok = ok + 1;
        } else if (r.status == "ABIERTO" || r.status == "REGRESIÓN") {
            open = open + 1;
        }
        i = i + 1;
    }
    print("");
    print(
        "${ok} OK · ${open} abiertos o en regresión · ${rows.len() - ok - open} por decisión, medición o fuera de alcance"
    );
}

fn pad_left(s: string, width: int) -> string {
    var out: string = s;
    while (out.len() < width) {
        out = " " + out;
    }
    out
}

fn pad_right(s: string, width: int) -> string {
    var out: string = s;
    while (out.len() < width) {
        out = out + " ";
    }
    out
}

// [2] [3] [18] [23] Lo que raystream necesitaba de `net/webserver`, comprobado sin servidor:
// se construye la petición a mano y se inspecciona la respuesta que devuelve el paquete.
// Cada línea de salida es `<n>:<veredicto>` y el comprobador la interpreta.
import std/fs;
import net/webserver;

fn main() -> int {
    let dir: string = fs.make_temp_dir("raystream_findings").unwrap_or("/tmp");
    let file: string = dir + "/big.bin";
    // 2 MB: por encima del umbral de 1 MB a partir del cual el paquete no carga el fichero.
    var seed: [int] = [];
    var i: int = 0;
    while (i < 2097152) {
        seed.push(i % 251);
        i = i + 1;
    }
    fs.write_file_bytes(file, bytes_of(seed)).unwrap_or(0);

    // [2] static_mount con un Range de 11 octetos: el cuerpo NO puede venir ya leído.
    let r2: webserver.Response = webserver.static_mount(
        "/m/",
        dir,
        request("GET", "/m/big.bin", "bytes=0-10")
    );
    print(
        "2:"
            + if (r2.body.len() == 0 && (r2.file.len() + r2.stream.len()) > 0) {
                "lazy"
            } else {
                "eager-${r2.body.len()}"
            }
    );

    // [3] Un cuerpo en streaming de tamaño conocido debe anunciar Content-Length.
    let ch: Channel<bytes> = Channel.new();
    close(ch);
    let r3: webserver.Response = webserver.stream_response_len(206, ch, 11);
    print("3:" + match (r3.headers.get("Content-Length")) {
        Option.Some(v) => "content-length-${v}",
        Option.None => "chunked",
    });

    // [18] serve_file de un fichero grande: cuerpo de fichero leído por el emisor, sin canal.
    let r18: webserver.Response = webserver.serve_file(file, request("GET", "/f", ""));
    print("18:" + if (r18.file.len() == 1 && r18.stream.len() == 0) {
        "filebody"
    } else if (r18.stream.len() == 1) {
        "producer-channel"
    } else {
        "other"
    });

    // [23] El emisor que conoce la petición existe (si no, esto no compila).
    let f23: fn(webserver.Request, int, webserver.Response) -> Result<int, string> = webserver.send_response_for;
    print("23:send_response_for");

    fs.remove_all(dir).unwrap_or(0);
    0
}

fn request(method: string, path: string, range: string) -> webserver.Request {
    var h: Map<string, string> = Map.new();
    if (range != "") {
        h.insert("range", range);
    }
    webserver.Request {
        method: method,
        path: path,
        query: "",
        version: "HTTP/1.1",
        headers: h,
        body: b"",
        remote: ""
    }
}

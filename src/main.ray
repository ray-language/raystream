// raystream — un servidor de medios personal escrito en raylang.
//
// Un único puerto sobre `webserver.serve_raw_limits`: la conexión cruda es lo que permite
// abrir un stream SSE y hacer el upgrade a WebSocket; los ficheros los sirve el paquete.
// El enrutado, el catálogo y la política de seguridad (src/security.ray) son nuestros.
//
// Fibras: una por conexión, más el actor del catálogo, el hub de eventos, el vigilante
// del directorio y el actor de salas. Ninguna comparte memoria: todo por canales.
import catalog/indexer;
import catalog/library;
import catalog/scan;
import catalog/store;
import config;
import http/api;
import http/serve_media;
import live/events;
import live/room;
import net/webserver;
import router;
import samples;
import security;
import subtitles;
import thumbs;
from catalog/library import Item, Track;
from catalog/store import Store;
from config import Config;
from live/events import Hub;
from live/room import Rooms;
from router import Route;
from security import Policy;
from thumbs import Thumb;

/// Connections served at once; beyond this the accept loop parks and the kernel's
/// backlog holds the rest. Long-lived connections (SSE, rooms) have their own caps below it.
const MAX_CONNS: int = 128;

/// How long a client has to send its request line and headers.
const REQUEST_TIMEOUT_MS: int = 15000;

/// Longest free-text query accepted by /api/library.
const MAX_QUERY: int = 200;

fn main() -> int {
    match (config.parse(args())) {
        Result.Err(message) => {
            print(message);
            if (message.starts_with("raystream")) { 0 } else { 2 }
        },
        Result.Ok(cfg) => {
            match (boot(cfg)) {
                Result.Ok(code) => code,
                Result.Err(e) => {
                    eprint("raystream: ${e}");
                    1
                },
            }
        },
    }
}

// Prepara la biblioteca, levanta los actores y arranca el servidor.
fn boot(cfg: Config) -> Result<int, string> {
    let root: string = config.resolve_dir(cfg)?;
    let created: int = samples.populate(root)?;
    if (created > 0) {
        print("seeded ${created} sample files in ${root}");
    }
    let items: [Item] = indexer.build_timed(root)?;
    if (cfg.scan_only) {
        print_summary(items);
        return Result.Ok(0);
    }

    let st: Store = store.start(items);
    let hub: Hub = events.start();
    let rooms: Rooms = room.start();
    events.watch_library(hub, st, root);
    let policy: Policy = security.policy_for(cfg);

    // `serve_raw_limits` da el bucle de accept, los límites y el cierre de la conexión. En modo
    // red local, además, exige el token antes de llegar al manejador (`Limits.local_token`).
    // El handler va escrito INLINE en la llamada, la forma que también compila a nativo.
    let limits: webserver.Limits = webserver.default_limits();
    limits.max_conns = MAX_CONNS;
    limits.read_timeout_millis = REQUEST_TIMEOUT_MS;
    limits.local_token = policy.token;
    announce(cfg, policy, root);
    webserver.serve_raw_limits(cfg.host, cfg.port, limits, fn(req: webserver.Request, conn: int) {
        dispatch(st, hub, rooms, root, policy, req, conn);
    })
}

fn announce(cfg: Config, policy: Policy, root: string) {
    print("raystream listening on http://${cfg.host}:${cfg.port}  (library: ${root})");
    if (!config.is_loopback(cfg.host)) {
        print("");
        print("LAN mode: every device on the network can reach this port, so every request");
        print("needs the access token. Open this URL once on each device (it keeps a cookie):");
        print("  http://<this machine's address>:${cfg.port}/?ray_token=${policy.token}");
        print("The traffic is not encrypted: use it on networks you trust (see SECURITY.md).");
        print("");
    } else if (security.requires_token(policy)) {
        print(
            "Access token required. Open: http://${cfg.host}:${cfg.port}/?ray_token=${policy.token}"
        );
    }
}

fn print_summary(items: [Item]) {
    var i: int = 0;
    while (i < items.len()) {
        let it: Item = items[i];
        let extra: string = if (it.duration_ms > 0) {
            "${it.duration_ms}ms"
        } else if (it.width > 0) {
            "${it.width}x${it.height}"
        } else {
            "-"
        };
        print("  ${it.id}  ${library.kind_name(it.kind)}  ${it.size}  ${extra}  ${it.rel}");
        i = i + 1;
    }
}

// Lo que necesita cada respuesta para salir: la petición (para el HEAD y el Host), la
// conexión y, en modo red local, la cookie del token que haya que sembrar.
struct Out {
    req: webserver.Request,
    conn: int,
    cookie: string,
}

// El despachador: una ruta tipada y su respuesta. Cada conexión corre en su propia fibra.
fn dispatch(
    st: Store,
    hub: Hub,
    rooms: Rooms,
    root: string,
    policy: Policy,
    req: webserver.Request,
    conn: int
) {
    let out: Out = Out { req: req, conn: conn, cookie: security.token_cookie_for(req, policy) };
    match (security.refuse(req, policy)) {
        Option.Some(refusal) => {
            emit(out, refusal);
            return;
        },
        Option.None => { },
    }
    if (req.method != "GET" && req.method != "HEAD") {
        emit(out, webserver.text(405, "method not allowed\n"));
        return;
    }
    match (router.resolve(req.path)) {
        Route.Home => {
            send_asset(out, "index.html");
        },
        Route.Asset(name) => {
            send_asset(out, name);
        },
        Route.ApiLibrary => {
            let kind: string = router.query_param(req.query, "kind");
            let q: string = router.query_param(req.query, "q");
            if (q.len() > MAX_QUERY) {
                emit(out, webserver.text(414, "query too long\n"));
                return;
            }
            emit(out, webserver.json_response(api.library_json(st, kind, q)));
        },
        Route.ApiStats => {
            emit(out, webserver.json_response(api.stats_json(st, library.base_name(root))));
        },
        Route.ApiItem(id) => {
            match (api.item_json(st, id)) {
                Option.Some(body) => {
                    emit(out, webserver.json_response(body));
                },
                Option.None => {
                    send_not_found(out);
                },
            }
        },
        Route.Media(id) => {
            serve_item(st, root, id, out);
        },
        Route.Thumb(id) => {
            serve_thumb(st, root, id, out);
        },
        Route.Subtitle(id, index) => {
            serve_subtitle(st, root, id, index, out);
        },
        Route.Events => {
            events.serve_sse(hub, conn);
        },
        Route.Room(name) => {
            if (!security.valid_room_name(name)) {
                emit(out, webserver.text(400, "invalid room name\n"));
                return;
            }
            room.serve_room(rooms, name, req, conn);
        },
        Route.NotFound => {
            emit(out, webserver.text(404, "not found\n"));
        },
    }
}

// Sirve el fichero de un item por id, con Range: éste es el camino caliente.
fn serve_item(st: Store, root: string, id: string, out: Out) {
    match (store.find_by_id(st, id)) {
        Option.None => {
            send_not_found(out);
        },
        Option.Some(it) => {
            match (scan.safe_path(root, it.rel)) {
                Result.Err(_) => {
                    send_not_found(out);
                },
                Result.Ok(path) => {
                    let r: webserver.Response = serve_media.response_for(path, it.mime, out.req);
                    if (emit(out, r)) {
                        print(
                            "${out.req.method} /media/${id} → ${r.status} (${serve_media.length_of(r)} bytes)"
                        );
                    }
                },
            }
        },
    }
}

// Miniatura: un PNG reescalado (de la caché de disco), la carátula embebida en el audio (un
// rango del propio fichero) o el original de una imagen que no se reescala. Nada de eso pasa
// entero por la memoria.
fn serve_thumb(st: Store, root: string, id: string, out: Out) {
    match (store.find_by_id(st, id)) {
        Option.None => {
            send_not_found(out);
        },
        Option.Some(it) => {
            match (scan.safe_path(root, it.rel)) {
                Result.Err(_) => {
                    send_not_found(out);
                },
                Result.Ok(path) => {
                    let r: webserver.Response = match (thumbs.thumbnail(root, path, it)) {
                        Thumb.Missing => webserver.text(404, "no thumbnail\n"),
                        Thumb.File(file, mime) => serve_media.response_for(file, mime, out.req),
                        Thumb.Range(file, from_byte, to_byte, mime) => thumbs.range_response(file, from_byte, to_byte, mime),
                    };
                    r.headers.insert("Cache-Control", "private, max-age=86400");
                    emit(out, r);
                },
            }
        },
    }
}

// Una pista de subtítulos, siempre como WebVTT: un .srt se convierte al vuelo porque el
// <track> del navegador no sabe leerlo.
fn serve_subtitle(st: Store, root: string, id: string, index: int, out: Out) {
    match (store.find_by_id(st, id)) {
        Option.None => {
            send_not_found(out);
        },
        Option.Some(it) => {
            if (index < 0 || index >= it.tracks.len()) {
                emit(out, webserver.text(404, "no such subtitle track\n"));
                return;
            }
            let track: Track = it.tracks[index];
            match (scan.safe_path(root, track.rel)) {
                Result.Err(_) => {
                    send_not_found(out);
                },
                Result.Ok(path) => {
                    match (subtitles.load_as_vtt(path, track.format)) {
                        Result.Err(e) => {
                            // Sin detalles internos: el motivo va al registro, no al cliente.
                            eprint("subtitle ${track.rel}: ${e}");
                            let status: int = if (e.contains("too large")) { 413 } else { 500 };
                            emit(out, webserver.text(status, "subtitle unavailable\n"));
                        },
                        Result.Ok(vtt) => {
                            var r: webserver.Response = webserver.text(200, vtt);
                            r.headers.insert("Content-Type", "text/vtt; charset=utf-8");
                            r.headers.insert("Cache-Control", "private, max-age=3600");
                            emit(out, r);
                        },
                    }
                },
            }
        },
    }
}

// Los assets de la UI se sirven con el mount de `std/embed` del paquete: saneo de la ruta,
// ETag de contenido, 304 y MIME por extensión, en disco bajo `ray run` y horneados en el
// binario nativo. La petición se reescribe para que `/` sea `/assets/index.html`.
fn send_asset(out: Out, name: string) {
    out.req.path = "/assets/" + name;
    emit(out, webserver.static_mount_embedded("/assets/", "assets", out.req));
}

fn send_not_found(out: Out) {
    var r: webserver.Response = webserver.json_response(api.error_json("not found"));
    r.status = 404;
    emit(out, r);
}

// El punto único de salida: cabeceras de seguridad, la cookie del token si toca, y el emisor
// que respeta el HEAD. Devuelve si se pudo escribir.
fn emit(out: Out, r: webserver.Response) -> bool {
    let hardened: webserver.Response = security.harden(r, out.req);
    if (out.cookie != "") {
        hardened.set_cookie.push(out.cookie);
    }
    match (webserver.send_response_for(out.req, out.conn, hardened)) {
        Result.Ok(_) => true,
        Result.Err(e) => {
            eprint("send: ${e}");
            false
        },
    }
}

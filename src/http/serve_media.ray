// Servir un fichero de medios por la conexión.
//
// El trabajo pesado lo hace el paquete: `webserver.serve_file` resuelve el ETag fuerte de
// tamaño+mtime, `If-None-Match` → 304, `Range`/206/416 con `If-Range` y, a partir de 1 MB,
// el cuerpo leído del disco por trozos en la propia fibra de la conexión — nunca el fichero
// entero en memoria. Y `send_response_for` respeta el método: en un HEAD escribe las
// cabeceras con su `Content-Length` y ningún octeto de cuerpo.
//
// Lo único que sigue siendo nuestro es el `Content-Type`: el `mime_of` del paquete no
// conoce `.mov`, `.mkv`, `.m4a`, `.flac` ni `.ogg`, y el índice sí sabe qué es cada fichero.
import net/webserver;

/// What a transfer ended up doing, for the access log.
pub struct Sent {
    status: int,
    length: int,
}

/// Serves `path` as the response to `req`, forcing `mime` as the content type. A `HEAD`
/// is honoured by the sender, so it needs nothing special here.
pub fn serve_file(
    conn: int,
    path: string,
    mime: string,
    req: webserver.Request
) -> Result<Sent, string> {
    let r: webserver.Response = webserver.serve_file(path, req);
    r.headers.insert("Content-Type", mime);
    r.headers.insert("Cache-Control", "private, max-age=3600");
    webserver.send_response_for(req, conn, r)?;
    Result.Ok(Sent { status: r.status, length: length_of(r) })
}

// Los octetos que va a llevar la respuesta, para el log: el cuerpo ya materializado o el
// Content-Length que anunció el camino de fichero.
fn length_of(r: webserver.Response) -> int {
    if (r.body.len() > 0) {
        return r.body.len();
    }
    match (r.headers.get("Content-Length")) {
        Option.Some(v) => parse_int(v).unwrap_or(0),
        Option.None => 0,
    }
}

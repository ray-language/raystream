// La respuesta para un fichero de medios.
//
// El trabajo pesado lo hace el paquete: `webserver.serve_file` resuelve el ETag fuerte de
// tamaño+mtime, `If-None-Match` → 304, `Range`/206/416 con `If-Range` y, a partir de 1 MB,
// el cuerpo leído del disco por trozos en la propia fibra de la conexión — nunca el fichero
// entero en memoria. La envía `main` por el punto único de salida, que añade las cabeceras de
// seguridad y respeta el HEAD.
//
// Lo único que sigue siendo nuestro es el `Content-Type`: el `mime_of` del paquete no
// conoce `.mov`, `.mkv`, `.m4a`, `.flac` ni `.ogg`, y el índice sí sabe qué es cada fichero.
import net/webserver;

/// The response for `path`, with `mime` as its content type.
pub fn response_for(path: string, mime: string, req: webserver.Request) -> webserver.Response {
    let r: webserver.Response = webserver.serve_file(path, req);
    r.headers.insert("Content-Type", mime);
    r.headers.insert("Cache-Control", "private, max-age=3600");
    r
}

/// The octets a response will carry, for the access log: the materialised body, or the
/// `Content-Length` the file path announced.
pub fn length_of(r: webserver.Response) -> int {
    if (r.body.len() > 0) {
        return r.body.len();
    }
    match (r.headers.get("Content-Length")) {
        Option.Some(v) => parse_int(v).unwrap_or(0),
        Option.None => 0,
    }
}

// Salas sincronizadas: varios navegadores viendo o escuchando lo mismo, a la vez.
//
// Un actor por servidor guarda el estado de cada sala; cada conexión WebSocket usa dos
// fibras, una que lee del socket y otra que escribe lo que difunde la sala, coordinadas
// con `select` sobre dos canales. El socket lo lee UNA sola fibra: los frames no se
// mezclan.
import std/json;
import std/net;
import std/time;
import net/webserver;
import net/websocket;
import security;

/// Members across all rooms at once. Each one holds a connection slot for as long as it
/// stays, so the cap keeps rooms from starving the media (the server has 128 slots).
pub const MAX_MEMBERS: int = 32;

/// Rooms alive at once (a room lives while it has members).
pub const MAX_ROOMS: int = 16;

/// Largest message accepted from a client. Room messages are a few dozen octets of JSON.
pub const MAX_MESSAGE: int = 4096;

/// Messages per second a member may send; the excess is dropped (each one is re-broadcast
/// to the whole room, so this also bounds what one member can make the server send).
pub const MAX_RATE: int = 10;

// Lo que un cliente puede pedir y lo que la sala responde: un JSON con `type`.
enum RoomMsg {
    Join(Member),
    Leave(int),
    Update(Change),
    Snapshot(Ask),
}

struct Member {
    room: string,
    ch: Channel<string>,
    reply: Channel<int>,
}

struct Change {
    room: string,
    from_id: int,
    action: string,
    item_id: string,
    position_ms: int,
}

struct Ask {
    room: string,
    reply: Channel<string>,
}

/// A handle to the rooms actor.
pub struct Rooms {
    inbox: Channel<RoomMsg>,
}

// El estado de una sala: qué se reproduce, dónde y desde cuándo.
struct RoomState {
    name: string,
    item_id: string,
    position_ms: int,
    playing: bool,
    updated_at: int,
}

/// Starts the rooms actor.
pub fn start() -> Rooms {
    let inbox: Channel<RoomMsg> = Channel.new();
    spawn(fn() {
        run(inbox);
    });
    Rooms { inbox: inbox }
}

fn run(inbox: Channel<RoomMsg>) {
    var states: [RoomState] = [];
    var member_ids: [int] = [];
    var member_rooms: [string] = [];
    var member_chans: [Channel<string>] = [];
    var next_id: int = 1;
    var go: bool = true;
    while (go) {
        match (recv(inbox)) {
            Option.None => {
                go = false;
            },
            Option.Some(msg) => {
                match (msg) {
                    RoomMsg.Join(m) => {
                        // 0 = no hay sitio: demasiados miembros, o sala nueva sin hueco.
                        let is_new: bool = find_room(states, m.room) < 0;
                        if (member_ids.len() >= MAX_MEMBERS
                            || (is_new && states.len() >= MAX_ROOMS)) {
                            send(m.reply, 0);
                        } else {
                            member_ids.push(next_id);
                            member_rooms.push(m.room);
                            member_chans.push(m.ch);
                            send(m.reply, next_id);
                            next_id = next_id + 1;
                            let st: RoomState = ensure_room(states, m.room);
                            send(m.ch, state_json(st, "state"));
                        }
                    },
                    RoomMsg.Leave(id) => {
                        var ids: [int] = [];
                        var rooms: [string] = [];
                        var chans: [Channel<string>] = [];
                        var i: int = 0;
                        while (i < member_ids.len()) {
                            if (member_ids[i] != id) {
                                ids.push(member_ids[i]);
                                rooms.push(member_rooms[i]);
                                chans.push(member_chans[i]);
                            }
                            i = i + 1;
                        }
                        member_ids = ids;
                        member_rooms = rooms;
                        member_chans = chans;
                        // Una sala sin miembros desaparece: no se acumulan salas abandonadas.
                        states = occupied(states, member_rooms);
                    },
                    RoomMsg.Snapshot(ask) => {
                        let i: int = find_room(states, ask.room);
                        send(ask.reply, if (i < 0) { "" } else { state_json(states[i], "state") });
                    },
                    RoomMsg.Update(ch) => {
                        if (find_room(states, ch.room) < 0) {
                            continue;
                        }
                        let st: RoomState = ensure_room(states, ch.room);
                        apply(st, ch);
                        let payload: string = state_json(st, "state");
                        var i: int = 0;
                        while (i < member_ids.len()) {
                            if (member_rooms[i] == ch.room) {
                                send(member_chans[i], payload);
                            }
                            i = i + 1;
                        }
                    },
                }
            },
        }
    }
}

fn find_room(states: [RoomState], name: string) -> int {
    var i: int = 0;
    while (i < states.len()) {
        if (states[i].name == name) {
            return i;
        }
        i = i + 1;
    }
    0 - 1
}

// Las salas que aún tienen algún miembro.
fn occupied(states: [RoomState], member_rooms: [string]) -> [RoomState] {
    var keep: [RoomState] = [];
    var i: int = 0;
    while (i < states.len()) {
        if (member_rooms.contains(states[i].name)) {
            keep.push(states[i]);
        }
        i = i + 1;
    }
    keep
}

// Devuelve la sala (creándola la primera vez). Los structs son referencias: mutar la
// devuelta muta la que está en la lista.
fn ensure_room(states: [RoomState], name: string) -> RoomState {
    var i: int = 0;
    while (i < states.len()) {
        if (states[i].name == name) {
            return states[i];
        }
        i = i + 1;
    }
    let fresh: RoomState = RoomState {
        name: name,
        item_id: "",
        position_ms: 0,
        playing: false,
        updated_at: time.now()
    };
    states.push(fresh);
    fresh
}

fn apply(st: RoomState, ch: Change) {
    if (ch.action == "load") {
        st.item_id = ch.item_id;
        st.position_ms = 0;
        st.playing = false;
    } else if (ch.action == "play") {
        st.playing = true;
        st.position_ms = ch.position_ms;
    } else if (ch.action == "pause") {
        st.playing = false;
        st.position_ms = ch.position_ms;
    } else if (ch.action == "seek") {
        st.position_ms = ch.position_ms;
    }
    st.updated_at = time.now();
}

fn state_json(st: RoomState, kind: string) -> string {
    json.obj()
        .field("type", kind)
        .field("room", st.name)
        .field("item_id", st.item_id)
        .field("position_ms", st.position_ms)
        .field("playing", st.playing)
        .field("updated_at", st.updated_at)
        .render()
}

/// Handles `GET /ws/room/:name`: performs the upgrade and joins the room. Blocks the
/// connection fiber until the socket dies.
pub fn serve_room(rooms: Rooms, room: string, req: webserver.Request, conn: int) {
    let key: string = match (get(req.headers, "sec-websocket-key")) {
        Option.Some(v) => v,
        Option.None => "",
    };
    if (key == "") {
        let r: webserver.Response = webserver.text(400, "not a websocket handshake\n");
        webserver.send_response(conn, r).unwrap_or(0);
        return;
    }

    // Alta en la sala ANTES del apretón de manos: si no hay sitio, se contesta 503 sin llegar
    // a abrir el WebSocket.
    let from_room: Channel<string> = Channel.new();
    let reply: Channel<int> = Channel.new();
    send(rooms.inbox, RoomMsg.Join(Member { room: room, ch: from_room, reply: reply }));
    let id: int = recv(reply).unwrap_or(0);
    if (id == 0) {
        webserver.send_response(conn, webserver.text(503, "rooms are full\n")).unwrap_or(0);
        return;
    }
    match (net.socket_write(conn, websocket.handshake_response(key))) {
        Result.Err(_) => {
            send(rooms.inbox, RoomMsg.Leave(id));
            return;
        },
        Result.Ok(_) => { },
    }

    // Una fibra lee el socket y vuelca los mensajes en un canal; así la fibra principal
    // puede esperar con `select` al socket Y a la sala a la vez.
    let from_socket: Channel<string> = Channel.new();
    spawn(fn() {
        reader(conn, from_socket);
    });

    var window_start: int = time.now();
    var in_window: int = 0;
    var go: bool = true;
    while (go) {
        let ready: int = select([from_socket, from_room]);
        if (ready == 0) {
            match (recv(from_socket)) {
                Option.None => {
                    go = false;
                },
                Option.Some(text) => {
                    // Límite de ritmo por ventanas de un segundo: lo que sobra se descarta.
                    let now: int = time.now();
                    if (now - window_start >= 1000) {
                        window_start = now;
                        in_window = 0;
                    }
                    in_window = in_window + 1;
                    if (in_window <= MAX_RATE) {
                        handle_client_message(rooms, room, id, text);
                    }
                },
            }
        } else {
            match (recv(from_room)) {
                Option.None => {
                    go = false;
                },
                Option.Some(payload) => {
                    match (net.socket_write_bytes(conn, websocket.encode_text(payload))) {
                        Result.Err(_) => {
                            go = false;
                        },
                        Result.Ok(_) => { },
                    }
                },
            }
        }
    }
    send(rooms.inbox, RoomMsg.Leave(id));
    // El cierre del socket lo hace quien aceptó la conexión (src/main.ray).
}

// La fibra lectora: cada mensaje de texto del cliente va al canal; un cierre lo cierra.
fn reader(conn: int, out: Channel<string>) {
    let ws: websocket.WsConn = websocket.server_conn(conn);
    var go: bool = true;
    while (go) {
        // Un mensaje por encima del tope es un error de lectura: se corta la conexión.
        match (websocket.read_message_limit(ws, MAX_MESSAGE)) {
            Result.Err(_) => {
                go = false;
            },
            Result.Ok(frame) => {
                if (frame.opcode == websocket.op_close()) {
                    go = false;
                } else if (frame.opcode == websocket.op_text()) {
                    match (from_utf8(frame.payload)) {
                        Result.Ok(text) => {
                            send(out, text);
                        },
                        Result.Err(_) => { },
                    }
                }
            },
        }
    }
    close(out);
}

fn handle_client_message(rooms: Rooms, room: string, id: int, text: string) {
    match (json.parse(text)) {
        Result.Err(_) => { },
        Result.Ok(j) => {
            // Todo lo que llega del cliente se valida antes de guardarlo y reenviarlo a la sala.
            let action: string = json.get_string(j, "type").unwrap_or("");
            if (action != "load" && action != "play" && action != "pause" && action != "seek") {
                return;
            }
            let item_id: string = json.get_string(j, "item_id").unwrap_or("");
            if (!security.valid_item_id(item_id)) {
                return;
            }
            let position: int = clamp(
                json.get_int(j, "position_ms").unwrap_or(0),
                0,
                MAX_POSITION_MS
            );
            send(
                rooms.inbox,
                RoomMsg.Update(
                    Change {
                        room: room,
                        from_id: id,
                        action: action,
                        item_id: item_id,
                        position_ms: position
                    }
                )
            );
        },
    }
}

/// Longest position accepted, in ms (a week: no film is longer).
const MAX_POSITION_MS: int = 604800000;

fn clamp(v: int, low: int, high: int) -> int {
    if (v < low) { low } else if (v > high) { high } else { v }
}

@test
fn a_room_broadcasts_state_to_its_members() {
    let rooms: Rooms = start();
    let a: Channel<string> = Channel.new();
    let b: Channel<string> = Channel.new();
    let other: Channel<string> = Channel.new();
    let ra: Channel<int> = Channel.new();
    let rb: Channel<int> = Channel.new();
    let ro: Channel<int> = Channel.new();
    send(rooms.inbox, RoomMsg.Join(Member { room: "salon", ch: a, reply: ra }));
    send(rooms.inbox, RoomMsg.Join(Member { room: "salon", ch: b, reply: rb }));
    send(rooms.inbox, RoomMsg.Join(Member { room: "cocina", ch: other, reply: ro }));
    let id_a: int = recv(ra).unwrap_or(0);
    let _b: int = recv(rb).unwrap_or(0);
    let _o: int = recv(ro).unwrap_or(0);

    // Al entrar, cada uno recibe el estado inicial de SU sala.
    assert_eq(json_str(recv(a).unwrap_or(""), "room"), "salon");
    assert_eq(json_str(recv(b).unwrap_or(""), "room"), "salon");
    assert_eq(json_str(recv(other).unwrap_or(""), "room"), "cocina");

    send(
        rooms.inbox,
        RoomMsg.Update(
            Change { room: "salon", from_id: id_a, action: "load", item_id: "abc", position_ms: 0 }
        )
    );
    send(
        rooms.inbox,
        RoomMsg.Update(
            Change { room: "salon", from_id: id_a, action: "play", item_id: "", position_ms: 4200 }
        )
    );

    assert_eq(json_str(recv(a).unwrap_or(""), "item_id"), "abc");
    let played: string = recv(a).unwrap_or("");
    assert(json_bool(played, "playing"));
    assert_eq(json_int(played, "position_ms"), 4200);
    // El otro miembro de la sala ve lo mismo…
    assert_eq(json_str(recv(b).unwrap_or(""), "item_id"), "abc");
    // …y la sala de al lado no se entera.
    match (try_recv(other)) {
        Received.Got(v) => panic("another room got ${v}"),
        Received.Empty => { },
        Received.Closed => { },
    }
}

@test
fn leaving_stops_the_updates_and_an_empty_room_disappears() {
    let rooms: Rooms = start();
    let a: Channel<string> = Channel.new();
    let ra: Channel<int> = Channel.new();
    send(rooms.inbox, RoomMsg.Join(Member { room: "r", ch: a, reply: ra }));
    let id: int = recv(ra).unwrap_or(0);
    let _initial: string = recv(a).unwrap_or("");
    send(rooms.inbox, RoomMsg.Leave(id));
    send(
        rooms.inbox,
        RoomMsg.Update(
            Change { room: "r", from_id: 0, action: "play", item_id: "", position_ms: 1 }
        )
    );
    // La sala se borró con su último miembro: no hay estado que consultar ni nada que difundir.
    let ask: Channel<string> = Channel.new();
    send(rooms.inbox, RoomMsg.Snapshot(Ask { room: "r", reply: ask }));
    assert_eq(recv(ask).unwrap_or("?"), "");
    match (try_recv(a)) {
        Received.Got(v) => panic("a member who left got ${v}"),
        Received.Empty => { },
        Received.Closed => { },
    }
}

@test
fn members_and_rooms_are_capped() {
    let rooms: Rooms = start();
    // MAX_ROOMS salas de un miembro cada una llenan el cupo de salas…
    var i: int = 0;
    while (i < MAX_ROOMS) {
        assert(join_room(rooms, "room${i}") > 0);
        i = i + 1;
    }
    // …así que una sala nueva ya no cabe, pero una existente sí admite otro miembro.
    assert_eq(join_room(rooms, "one-too-many"), 0);
    assert(join_room(rooms, "room0") > 0);
    // Y hasta MAX_MEMBERS miembros en total.
    var k: int = MAX_ROOMS + 1;
    while (k < MAX_MEMBERS) {
        assert(join_room(rooms, "room1") > 0);
        k = k + 1;
    }
    assert_eq(join_room(rooms, "room1"), 0);
}

fn join_room(rooms: Rooms, name: string) -> int {
    let ch: Channel<string> = Channel.new();
    let reply: Channel<int> = Channel.new();
    send(rooms.inbox, RoomMsg.Join(Member { room: name, ch: ch, reply: reply }));
    recv(reply).unwrap_or(0)
}

@test
fn only_valid_messages_reach_the_room() {
    let rooms: Rooms = start();
    let a: Channel<string> = Channel.new();
    let ra: Channel<int> = Channel.new();
    send(rooms.inbox, RoomMsg.Join(Member { room: "v", ch: a, reply: ra }));
    let id: int = recv(ra).unwrap_or(0);
    let _initial: string = recv(a).unwrap_or("");
    // Acción desconocida, id con HTML, id demasiado largo: nada de eso se difunde.
    handle_client_message(rooms, "v", id, "{\"type\":\"drop\"}");
    handle_client_message(rooms, "v", id, "{\"type\":\"load\",\"item_id\":\"<img src=x>\"}");
    handle_client_message(
        rooms,
        "v",
        id,
        "{\"type\":\"load\",\"item_id\":\"" + "a".repeat(5000) + "\"}"
    );
    // Uno válido sí, con la posición acotada.
    handle_client_message(rooms, "v", id, "{\"type\":\"seek\",\"position_ms\":99999999999999}");
    let got: string = recv(a).unwrap_or("");
    assert_eq(json_int(got, "position_ms"), MAX_POSITION_MS);
    match (try_recv(a)) {
        Received.Got(v) => panic("an invalid message was broadcast: ${v}"),
        Received.Empty => { },
        Received.Closed => { },
    }
}

// Lee un campo de un JSON ya serializado. Los tests comprueban valores, no el formato:
// `json.render` cambió su espaciado entre versiones y los tests que comparaban texto se
// rompieron sin que cambiara nada del comportamiento.
fn json_str(text: string, key: string) -> string {
    match (json.parse(text)) {
        Result.Ok(j) => json.get_string(j, key).unwrap_or("<ausente>"),
        Result.Err(e) => "<json inválido: ${e}>",
    }
}

fn json_int(text: string, key: string) -> int {
    match (json.parse(text)) {
        Result.Ok(j) => json.get_int(j, key).unwrap_or(0 - 1),
        Result.Err(_) => 0 - 1,
    }
}

fn json_bool(text: string, key: string) -> bool {
    match (json.parse(text)) {
        Result.Ok(j) => json.get_bool(j, key).unwrap_or(false),
        Result.Err(_) => false,
    }
}

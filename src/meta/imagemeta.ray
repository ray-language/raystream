// Dimensiones de una imagen SIN decodificarla: PNG (chunk IHDR), JPEG (marcador SOF),
// GIF (screen descriptor) y WebP (VP8/VP8L/VP8X). Con los primeros kilobytes basta.
import meta/binary;

/// Pixel dimensions of an image (0 × 0 when the format is not recognised).
pub struct Dimensions {
    width: int,
    height: int,
}

/// Reads the dimensions out of a header. `head` should be the first ~64 KB of the file:
/// a JPEG can carry a long EXIF block before its SOF marker.
pub fn parse(head: bytes) -> Option<Dimensions> {
    if (head.starts_with(bytes_of([0x89, 0x50, 0x4E, 0x47]))) {
        return png(head);
    }
    if (head.starts_with(bytes_of([0xFF, 0xD8]))) {
        return jpeg(head);
    }
    if (head.starts_with(b"GIF87a") || head.starts_with(b"GIF89a")) {
        return gif(head);
    }
    if (head.starts_with(b"RIFF") && binary.tag4(head, 8) == "WEBP") {
        return webp(head);
    }
    Option.None
}

// PNG: el primer chunk es siempre IHDR, con ancho y alto en big-endian.
fn png(head: bytes) -> Option<Dimensions> {
    if (head.len() < 24 || binary.tag4(head, 12) != "IHDR") {
        return Option.None;
    }
    Option.Some(Dimensions { width: binary.be_u32(head, 16), height: binary.be_u32(head, 20) })
}

// JPEG: recorrer los marcadores hasta un SOF (todos menos SOF4/SOF8/SOF12, que no lo son).
fn jpeg(head: bytes) -> Option<Dimensions> {
    var i: int = 2;
    while (i + 9 < head.len()) {
        if (head[i] != 0xFF) {
            i = i + 1;
            continue;
        }
        let marker: int = head[i + 1];
        if (marker == 0xD8 || marker == 0x1 || (marker >= 0xD0 && marker <= 0xD7)) {
            i = i + 2;
            continue;
        }
        let seg_len: int = binary.be_u16(head, i + 2);
        if (is_sof(marker)) {
            // SOF: precisión (1) + alto (2) + ancho (2) tras la longitud.
            return Option.Some(
                Dimensions { width: binary.be_u16(head, i + 7), height: binary.be_u16(head, i + 5) }
            );
        }
        if (seg_len <= 0) {
            return Option.None;
        }
        i = i + 2 + seg_len;
    }
    Option.None
}

fn is_sof(marker: int) -> bool {
    if (marker < 0xC0 || marker > 0xCF) {
        return false;
    }
    // C4 = tabla Huffman, C8 = extensión JPEG, CC = aritmética: no son SOF.
    marker != 0xC4 && marker != 0xC8 && marker != 0xCC
}

// GIF: ancho y alto little-endian en el logical screen descriptor.
fn gif(head: bytes) -> Option<Dimensions> {
    if (head.len() < 10) {
        return Option.None;
    }
    Option.Some(Dimensions { width: binary.le_u16(head, 6), height: binary.le_u16(head, 8) })
}

// WebP: tres variantes, cada una con su codificación de las dimensiones.
fn webp(head: bytes) -> Option<Dimensions> {
    let kind: string = binary.tag4(head, 12);
    if (kind == "VP8 " && head.len() >= 30) {
        // Lossy: dimensiones de 14 bits tras el start code.
        return Option.Some(
            Dimensions {
                width: binary.le_u16(head, 26) % 16384,
                height: binary.le_u16(head, 28) % 16384
            }
        );
    }
    if (kind == "VP8L" && head.len() >= 25) {
        // Lossless: 14 bits de ancho y 14 de alto, empaquetados tras la firma 0x2F.
        let b0: int = head[21];
        let b1: int = head[22];
        let b2: int = head[23];
        let b3: int = head[24];
        let w: int = (b0 + (b1 % 64) * 256) + 1;
        let h: int = ((b1 / 64) + b2 * 4 + (b3 % 16) * 1024) + 1;
        return Option.Some(Dimensions { width: w, height: h });
    }
    if (kind == "VP8X" && head.len() >= 30) {
        // Extended: canvas de 24 bits little-endian menos uno.
        let w: int = head[24] + head[25] * 256 + head[26] * 65536 + 1;
        let h: int = head[27] + head[28] * 256 + head[29] * 65536 + 1;
        return Option.Some(Dimensions { width: w, height: h });
    }
    Option.None
}

@test
fn png_dimensions() {
    var b: bytes = bytes_of([0x89, 0x50, 0x4E, 0x47, 0xD, 0xA, 0x1A, 0xA]);
    b = b + bytes_of([0, 0, 0, 13]) + b"IHDR";
    b = b + bytes_of([0, 0, 2, 128]);  // 640
    b = b + bytes_of([0, 0, 1, 104]);  // 360
    match (parse(b)) {
        Option.Some(d) => {
            assert_eq(d.width, 640);
            assert_eq(d.height, 360);
        },
        Option.None => panic("png should parse"),
    }
}

@test
fn jpeg_dimensions() {
    // SOI, un APP0 de relleno y un SOF0 de 1920×1080.
    var b: bytes = bytes_of([0xFF, 0xD8]);
    b = b + bytes_of([0xFF, 0xE0, 0, 4, 0, 0]);
    b = b + bytes_of([0xFF, 0xC0, 0, 17, 8]);
    b = b + bytes_of([4, 56]);  // alto 1080
    b = b + bytes_of([7, 128]);  // ancho 1920
    b = b + bytes_of([3, 1, 0x22, 0, 2, 0x11, 1, 3, 0x11, 1]);
    match (parse(b)) {
        Option.Some(d) => {
            assert_eq(d.width, 1920);
            assert_eq(d.height, 1080);
        },
        Option.None => panic("jpeg should parse"),
    }
}

@test
fn gif_dimensions() {
    let b: bytes = b"GIF89a" + bytes_of([0x20, 0x0, 0x10, 0x0, 0, 0]);
    match (parse(b)) {
        Option.Some(d) => {
            assert_eq(d.width, 32);
            assert_eq(d.height, 16);
        },
        Option.None => panic("gif should parse"),
    }
}

@test
fn unknown_formats_are_none() {
    match (parse(b"just some text")) {
        Option.Some(_) => panic("should not parse"),
        Option.None => { },
    }
}

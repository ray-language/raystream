// El segundo paso del indexado: abrir cada fichero lo justo para sacarle los metadatos.
// Nunca se lee un fichero entero — como mucho, una ventana de cabecera y otra de cola.
import std/fs;
import catalog/library;
import meta/id3;
import meta/imagemeta;
import meta/mp4;
import meta/wav;
from catalog/library import Item, Kind;

/// How much of the head of a file is read looking for headers.
pub const HEAD_WINDOW: int = 262144;

/// How much of the tail is read when an MP4 keeps its `moov` at the end.
pub const TAIL_WINDOW: int = 1048576;

/// Fills the metadata fields of `it` in place (duration, dimensions, tags, cover) by
/// reading the minimum from `path`. Anything unreadable simply leaves the defaults.
pub fn probe(path: string, it: Item) {
    match (it.kind) {
        Kind.Image => {
            probe_image(path, it);
        },
        Kind.Audio => {
            probe_audio(path, it);
        },
        Kind.Video => {
            probe_video(path, it);
        },
    }
}

fn probe_image(path: string, it: Item) {
    // 32 octetos bastan para PNG, GIF y WebP. Sólo un JPEG necesita más: su marcador SOF
    // puede venir detrás de un bloque EXIF, así que para él se lee hasta 64 KB.
    let small: bytes = read_window(path, 0, 32);
    let head: bytes = if (small.starts_with(bytes_of([0xFF, 0xD8]))) {
        read_window(path, 0, 65536)
    } else {
        small
    };
    match (imagemeta.parse(head)) {
        Option.Some(d) => {
            it.width = d.width;
            it.height = d.height;
        },
        Option.None => { },
    }
}

fn probe_audio(path: string, it: Item) {
    let ext: string = library.extension_of(it.rel);
    if (ext == "wav") {
        match (wav.parse(read_window(path, 0, 4096))) {
            Option.Some(info) => {
                it.duration_ms = info.duration_ms;
            },
            Option.None => { },
        }
        return;
    }
    if (ext == "m4a" || ext == "aac") {
        probe_video(path, it);
        return;
    }
    // MP3 y demás: etiquetas ID3 y duración estimada, leyendo sólo cabeceras.
    probe_id3(path, it, ext == "mp3");
}

// Recorre la etiqueta ID3 de cabecera en cabecera de marco: lee el cuerpo de los marcos de
// texto (pequeños) y SALTA el de la carátula, que sólo hace falta saber que existe. Después
// lee una ventana corta donde empieza el audio para la duración.
//
// La versión anterior leía 256 KB de cada fichero, releía la etiqueta entera si la carátula
// era mayor, y copiaba la imagen a memoria para descartarla: 300 µs por MP3 real y ~5 GB de
// lectura para 20.000 canciones (bench/probe_real.ray).
fn probe_id3(path: string, it: Item, want_duration: bool) {
    match (fs.open(path, "r")) {
        Result.Err(_) => { },
        Result.Ok(h) => {
            var audio_start: int = 0;
            match (id3.header_of(read_at(h, 0, 14))) {
                Option.None => { },
                Option.Some(hd) => {
                    audio_start = hd.total;
                    walk_frames(h, hd, it);
                },
            }
            if (want_duration) {
                let window: bytes = read_at(h, audio_start, AUDIO_WINDOW);
                it.duration_ms = id3.duration_from(window, it.size - audio_start);
            }
            close(h);
        },
    }
}

fn walk_frames(h: int, hd: id3.Header, it: Item) {
    let header_len: int = id3.frame_header_len(hd.major);
    var pos: int = hd.first_frame;
    while (pos + header_len <= hd.total) {
        let fh: id3.FrameHeader = id3.frame_header_of(read_at(h, pos, header_len), hd.major);
        // Relleno o fin de marcos: el resto de la etiqueta son ceros.
        if (fh.id == "" || fh.id.starts_with("\0") || fh.size <= 0) {
            return;
        }
        let body: int = pos + header_len;
        if (body + fh.size > hd.total) {
            return;
        }
        let field: string = id3.field_of(fh.id);
        if (field == "cover") {
            // Un APIC puede venir vacío: sólo cuenta si hay octetos de imagen detrás de su
            // cabecera (MIME, tipo y descripción), igual que en el parser completo.
            let prefix: bytes = read_at(h, body, min_int(fh.size, PICTURE_PREFIX));
            let start: int = id3.picture_data_offset(prefix, fh.id == "PIC");
            if (start >= 0 && fh.size > start) {
                it.has_cover = true;
            }
        } else if (field != "") {
            let text: string = id3.text_value(read_at(h, body, min_int(fh.size, TEXT_FRAME_MAX)));
            if (field == "title") {
                it.title = text;
            } else if (field == "artist") {
                it.artist = text;
            } else {
                it.album = text;
            }
        }
        pos = body + fh.size;
    }
}

/// Octets read from an APIC body to find where its image data starts.
const PICTURE_PREFIX: int = 512;

/// Longest text frame body read (titles and names; anything longer is cut).
const TEXT_FRAME_MAX: int = 4096;

/// Octets read where the audio starts, looking for the first MPEG frame header.
const AUDIO_WINDOW: int = 4096;

// `n` octetos a partir de `offset` en un fichero ya abierto (menos si se acaba).
fn read_at(h: int, offset: int, n: int) -> bytes {
    match (fs.seek(h, offset)) {
        Result.Err(_) => b"",
        Result.Ok(_) => {
            var out: bytes = b"";
            var go: bool = true;
            while (go && out.len() < n) {
                match (fs.read_bytes(h, n - out.len())) {
                    Result.Err(_) => {
                        go = false;
                    },
                    Result.Ok(piece) => {
                        match (piece) {
                            Option.None => {
                                go = false;
                            },
                            Option.Some(chunk) => {
                                if (chunk.len() == 0) {
                                    go = false;
                                } else {
                                    out = out + chunk;
                                }
                            },
                        }
                    },
                }
            }
            out
        },
    }
}

fn min_int(a: int, b: int) -> int {
    if (a < b) { a } else { b }
}

fn probe_video(path: string, it: Item) {
    let head: bytes = read_window(path, 0, HEAD_WINDOW);
    match (mp4.parse(head)) {
        Option.Some(info) => {
            apply_mp4(it, info);
            return;
        },
        Option.None => { },
    }
    // `moov` al final (ficheros no optimizados para streaming).
    if (it.size > HEAD_WINDOW) {
        let from_pos: int = if (it.size > TAIL_WINDOW) { it.size - TAIL_WINDOW } else { 0 };
        match (mp4.parse(read_window(path, from_pos, TAIL_WINDOW))) {
            Option.Some(info) => {
                apply_mp4(it, info);
            },
            Option.None => { },
        }
    }
}

fn apply_mp4(it: Item, info: mp4.Mp4Info) {
    if (info.duration_ms > 0) {
        it.duration_ms = info.duration_ms;
    }
    if (info.width > 0) {
        it.width = info.width;
        it.height = info.height;
    }
}

/// Where an audio file keeps its embedded cover: an inclusive byte range and a MIME type.
pub struct Cover {
    from_byte: int,
    to_byte: int,
    mime: string,
}

/// Locates the embedded cover of an audio file WITHOUT reading it: frame headers only, plus
/// the few octets before the picture that say where it starts. The result is a byte range of
/// the file itself, served straight from disk by `/thumb`.
pub fn cover_range(path: string) -> Option<Cover> {
    match (fs.open(path, "r")) {
        Result.Err(_) => Option.None,
        Result.Ok(h) => {
            let found: Option<Cover> = match (id3.header_of(read_at(h, 0, 14))) {
                Option.None => Option.None,
                Option.Some(hd) => find_cover(h, hd),
            };
            close(h);
            found
        },
    }
}

fn find_cover(h: int, hd: id3.Header) -> Option<Cover> {
    let header_len: int = id3.frame_header_len(hd.major);
    var pos: int = hd.first_frame;
    while (pos + header_len <= hd.total) {
        let fh: id3.FrameHeader = id3.frame_header_of(read_at(h, pos, header_len), hd.major);
        if (fh.id == "" || fh.id.starts_with("\0") || fh.size <= 0) {
            return Option.None;
        }
        let body: int = pos + header_len;
        if (body + fh.size > hd.total) {
            return Option.None;
        }
        if (id3.field_of(fh.id) == "cover") {
            let short_form: bool = fh.id == "PIC";
            let prefix: bytes = read_at(h, body, min_int(fh.size, PICTURE_PREFIX));
            let start: int = id3.picture_data_offset(prefix, short_form);
            if (start >= 0 && fh.size > start) {
                let declared: string = from_utf8(id3.picture_mime(prefix, short_form)).unwrap_or(
                    ""
                );
                return Option.Some(
                    Cover {
                        from_byte: body + start,
                        to_byte: body + fh.size - 1,
                        mime: safe_image_mime(declared)
                    }
                );
            }
        }
        pos = body + fh.size;
    }
    Option.None
}

/// The declared MIME type when it is one of the raster formats browsers render as an image,
/// otherwise `image/jpeg`. It goes into a response header (so no CR/LF may pass) and decides
/// how the browser treats the bytes (so no `image/svg+xml`: an SVG can carry scripts).
pub fn safe_image_mime(declared: string) -> string {
    let m: string = declared.trim().to_lower();
    let allowed: [string] = [
        "image/jpeg",
        "image/png",
        "image/gif",
        "image/webp",
        "image/avif",
        "image/bmp"
    ];
    if (allowed.contains(m)) { m } else { "image/jpeg" }
}

/// Reads at most `max` octets starting at `offset`. Bounded memory by construction:
/// this is the only door the metadata parsers have to the filesystem.
pub fn read_window(path: string, offset: int, max: int) -> bytes {
    match (fs.open(path, "r")) {
        Result.Err(_) => b"",
        Result.Ok(h) => {
            if (offset > 0) {
                match (fs.seek(h, offset)) {
                    Result.Err(_) => {
                        close(h);
                        return b"";
                    },
                    Result.Ok(_) => { },
                }
            }
            var out: bytes = b"";
            var go: bool = true;
            while (go && out.len() < max) {
                match (fs.read_bytes(h, max - out.len())) {
                    Result.Err(_) => {
                        go = false;
                    },
                    Result.Ok(chunk_opt) => {
                        match (chunk_opt) {
                            Option.None => {
                                go = false;
                            },
                            Option.Some(chunk) => {
                                if (chunk.len() == 0) {
                                    go = false;
                                } else {
                                    out = out + chunk;
                                }
                            },
                        }
                    },
                }
            }
            close(h);
            out
        },
    }
}

@test
fn probes_a_real_png_and_wav() {
    let root: string = fs.make_temp_dir("raystream_probe").unwrap_or("");
    // Un PNG de 2×1 con cabecera válida basta: sólo se lee el IHDR.
    let png: bytes = bytes_of([0x89, 0x50, 0x4E, 0x47, 0xD, 0xA, 0x1A, 0xA])
        + bytes_of([0, 0, 0, 13])
        + b"IHDR"
        + bytes_of([0, 0, 0, 2])
        + bytes_of([0, 0, 0, 1]);
    fs.write_file_bytes(root + "/a.png", png).unwrap_or(0);
    var it: Item = library.new_item("a.png", Kind.Image, png.len(), 0);
    probe(root + "/a.png", it);
    assert_eq(it.width, 2);
    assert_eq(it.height, 1);

    var wav_head: bytes = b"RIFF" + bytes_of([0, 0, 0, 0]) + b"WAVE" + b"fmt ";
    wav_head = wav_head + bytes_of([16, 0, 0, 0]) + bytes_of([1, 0]) + bytes_of([1, 0]);
    wav_head = wav_head + bytes_of([0x44, 0xAC, 0, 0]) + bytes_of([0x88, 0x58, 0x1, 0]);
    wav_head = wav_head + bytes_of([2, 0]) + bytes_of([16, 0]);
    wav_head = wav_head + b"data" + bytes_of([0x88, 0x58, 0x1, 0]);
    fs.write_file_bytes(root + "/a.wav", wav_head).unwrap_or(0);
    var wit: Item = library.new_item("a.wav", Kind.Audio, wav_head.len(), 0);
    probe(root + "/a.wav", wit);
    assert_eq(wit.duration_ms, 1000);

    fs.remove_all(root).unwrap_or(0);
}

@test
fn read_window_respects_its_bounds() {
    let root: string = fs.make_temp_dir("raystream_window").unwrap_or("");
    fs.write_file(root + "/x.bin", "0123456789").unwrap_or(0);
    assert_eq(read_window(root + "/x.bin", 0, 4), b"0123");
    assert_eq(read_window(root + "/x.bin", 6, 100), b"6789");
    assert_eq(read_window(root + "/missing", 0, 10), b"");
    fs.remove_all(root).unwrap_or(0);
}

@test
fn the_lean_mp3_probe_agrees_with_the_full_parser() {
    let root: string = fs.make_temp_dir("raystream_lean").unwrap_or("");
    // ID3v2.3 con título, artista, álbum y una carátula de 200 KB DELANTE de los textos,
    // para que el recorrido tenga que saltarla; luego una trama MPEG-1 Layer III a 128 kbps.
    var picture: [int] = [];
    var p: int = 0;
    while (p < 204800) {
        picture.push(p % 251);
        p = p + 1;
    }
    let apic: bytes = bytes_of([0])
        + b"image/jpeg"
        + bytes_of([0, 3])
        + b"x"
        + bytes_of([0])
        + bytes_of(picture);
    let frames: bytes = id3_frame("APIC", apic)
        + id3_frame("TIT2", bytes_of([0]) + b"Lean")
        + id3_frame("TPE1", bytes_of([0]) + b"Probe")
        + id3_frame("TALB", bytes_of([0]) + b"Album");
    let n: int = frames.len();
    let tag: bytes = b"ID3" + bytes_of(
        [3, 0, 0, (n / 2097152) % 128, (n / 16384) % 128, (n / 128) % 128, n % 128]
    ) + frames;
    var fill: [int] = [];
    var f: int = 0;
    while (f < 100000) {
        fill.push(0);
        f = f + 1;
    }
    let file: bytes = tag + bytes_of([0xFF, 0xFB, 0x90, 0x00]) + bytes_of(fill);
    fs.write_file_bytes(root + "/s.mp3", file).unwrap_or(0);

    var it: Item = library.new_item("s.mp3", Kind.Audio, file.len(), 0);
    probe(root + "/s.mp3", it);

    let full: id3.Tags = id3.parse(file);
    assert_eq(it.title, full.title);
    assert_eq(it.artist, full.artist);
    assert_eq(it.album, full.album);
    assert_eq(it.title, "Lean");
    assert(it.has_cover);
    assert_eq(it.duration_ms, id3.mp3_duration_ms(file, file.len()));
    fs.remove_all(root).unwrap_or(0);
}

fn id3_frame(id: string, body: bytes) -> bytes {
    let n: int = body.len();
    id.to_bytes()
        + bytes_of([(n / 16777216) % 256, (n / 65536) % 256, (n / 256) % 256, n % 256])
        + bytes_of([0, 0])
        + body
}

@test
fn an_empty_apic_frame_is_not_a_cover() {
    let root: string = fs.make_temp_dir("raystream_apic").unwrap_or("");
    // Un APIC con MIME, tipo y descripción, pero sin octetos de imagen.
    let apic: bytes = bytes_of([0]) + b"image/jpeg" + bytes_of([0, 3]) + b"x" + bytes_of([0]);
    let frames: bytes = id3_frame("TIT2", bytes_of([0]) + b"Sin imagen") + id3_frame("APIC", apic);
    let n: int = frames.len();
    let file: bytes = b"ID3"
        + bytes_of([3, 0, 0, 0, 0, (n / 128) % 128, n % 128])
        + frames
        + bytes_of([0xFF, 0xFB, 0x90, 0x00]);
    fs.write_file_bytes(root + "/e.mp3", file).unwrap_or(0);
    var it: Item = library.new_item("e.mp3", Kind.Audio, file.len(), 0);
    probe(root + "/e.mp3", it);
    assert_eq(it.title, "Sin imagen");
    assert(!it.has_cover);
    assert_eq(id3.parse(file).cover.len(), 0);
    fs.remove_all(root).unwrap_or(0);
}

@test
fn the_cover_is_located_as_a_range_of_the_file() {
    let root: string = fs.make_temp_dir("raystream_cover").unwrap_or("");
    let image_bytes: bytes = bytes_of([0x89, 0x50, 0x4E, 0x47, 1, 2, 3, 4, 5, 6]);
    let apic: bytes = bytes_of([0])
        + b"image/png"
        + bytes_of([0, 3])
        + b"front"
        + bytes_of([0])
        + image_bytes;
    let frames: bytes = id3_frame("TIT2", bytes_of([0]) + b"t") + id3_frame("APIC", apic);
    let n: int = frames.len();
    let file: bytes = b"ID3" + bytes_of([3, 0, 0, 0, 0, (n / 128) % 128, n % 128]) + frames;
    fs.write_file_bytes(root + "/c.mp3", file).unwrap_or(0);
    match (cover_range(root + "/c.mp3")) {
        Option.Some(c) => {
            assert_eq(c.mime, "image/png");
            assert_eq(file.sub_bytes(c.from_byte, c.to_byte + 1), image_bytes);
            // El mismo tramo que da el parser completo.
            assert_eq(id3.parse(file).cover, image_bytes);
        },
        Option.None => panic("the cover should be found"),
    }
    fs.remove_all(root).unwrap_or(0);
}

@test
fn a_hostile_cover_mime_cannot_reach_a_header() {
    assert_eq(safe_image_mime("image/png"), "image/png");
    assert_eq(safe_image_mime("IMAGE/JPEG"), "image/jpeg");
    assert_eq(safe_image_mime("image/svg+xml"), "image/jpeg");
    assert_eq(safe_image_mime("image/jpeg\r\nSet-Cookie: x=1"), "image/jpeg");
    assert_eq(safe_image_mime("text/html"), "image/jpeg");
    assert_eq(safe_image_mime(""), "image/jpeg");
}

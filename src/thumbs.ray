// Miniaturas, sin que ningún fichero pase ENTERO por la memoria:
//   - PNG: se reescala de verdad (filtro de caja sobre RGBA) y se cachea en disco; lo que se
//     sirve es el fichero cacheado. Sólo se decodifican PNG de hasta MAX_PNG_DECODE octetos.
//   - Audio con carátula embebida: la carátula es un RANGO del propio fichero; se localiza
//     leyendo cabeceras ID3 y se sirve ese tramo desde el disco.
//   - Cualquier otra imagen (y un PNG demasiado grande): el original, en streaming.
//
// La versión anterior leía el original entero (un GIF de 64 MB, seis veces a la vez, eran
// +1,1 GB de RSS) y copiaba la etiqueta ID3 completa para sacar la carátula (+1,3 GB). Ver
// SECURITY.md.
//
// Los JPEG no se reescalan: `std/image` sólo decodifica PNG (NOTES-raylang.md, hallazgo 9).
import std/fs;
import std/image;
import catalog/library;
import meta/probe;
import net/webserver;
from catalog/library import Item, Kind;

/// The longest side of a generated thumbnail, in pixels.
pub const MAX_SIDE: int = 400;

/// Largest PNG decoded to make a thumbnail; bigger ones are served as they are.
pub const MAX_PNG_DECODE: int = 8388608;

/// Where thumbnails are cached, relative to the library root.
pub const CACHE_SUBDIR: string = ".raystream/thumbs";

/// What to send as an item's thumbnail.
pub enum Thumb {
    // No hay miniatura (vídeo, audio sin carátula).
    Missing,
    // Un fichero entero: la miniatura cacheada o el original. (ruta, MIME)
    File(string, string),
    // Un tramo de un fichero: la carátula dentro de un MP3. (ruta, desde, hasta incl., MIME)
    Range(string, int, int, string),
}

/// Decides an item's thumbnail. Generates (and caches) the PNG one when needed.
pub fn thumbnail(root: string, path: string, it: Item) -> Thumb {
    match (it.kind) {
        Kind.Video => Thumb.Missing,
        Kind.Audio => {
            match (probe.cover_range(path)) {
                Option.Some(c) => Thumb.Range(path, c.from_byte, c.to_byte, c.mime),
                Option.None => Thumb.Missing,
            }
        },
        Kind.Image => image_thumb(root, path, it),
    }
}

fn image_thumb(root: string, path: string, it: Item) -> Thumb {
    if (library.extension_of(it.rel) != "png" || it.size > MAX_PNG_DECODE) {
        // Sin decodificador para el formato, o demasiado grande: el original, en streaming.
        return Thumb.File(path, it.mime);
    }
    let cached: string = png_thumb(root, path, it);
    if (cached == "") { Thumb.File(path, it.mime) } else { Thumb.File(cached, "image/png") }
}

/// A response whose body is `[from_byte, to_byte]` of `file`, read from disk in 64 KB pieces
/// (bounded memory, whatever the size). The package keeps its file-range responses private,
/// so the range is produced here over a sized stream.
pub fn range_response(
    file: string,
    from_byte: int,
    to_byte: int,
    mime: string
) -> webserver.Response {
    let length: int = to_byte - from_byte + 1;
    let ch: Channel<bytes> = Channel.bounded(1);
    spawn(fn() {
        match (fs.open(file, "r")) {
            Result.Err(_) => { },
            Result.Ok(h) => {
                fs.seek(h, from_byte).unwrap_or(0);
                var left: int = length;
                var go: bool = true;
                while (go && left > 0) {
                    let want: int = if (left < 65536) { left } else { 65536 };
                    match (fs.read_bytes(h, want)) {
                        Result.Ok(piece) => {
                            match (piece) {
                                Option.Some(chunk) => {
                                    if (chunk.len() == 0) {
                                        go = false;
                                    } else {
                                        send(ch, chunk);
                                        left = left - chunk.len();
                                    }
                                },
                                Option.None => {
                                    go = false;
                                },
                            }
                        },
                        Result.Err(_) => {
                            go = false;
                        },
                    }
                }
                close(h);
            },
        }
        close(ch);
    });
    let r: webserver.Response = webserver.stream_response_len(200, ch, length);
    r.headers.insert("Content-Type", mime);
    r
}

// La ruta de la miniatura PNG cacheada, generándola la primera vez ("" si no se pudo: el
// llamador sirve entonces el original). Una miniatura nunca debe romper la galería.
fn png_thumb(root: string, path: string, it: Item) -> string {
    let cache_dir: string = root + "/" + CACHE_SUBDIR;
    let cached: string = "${cache_dir}/${it.id}-${it.mtime_ms}.png";
    if (fs.exists(cached)) {
        return cached;
    }
    let original: bytes = match (fs.read_file_bytes(path)) {
        Result.Ok(data) => data,
        Result.Err(_) => b"",
    };
    if (original.len() == 0 || original.len() > MAX_PNG_DECODE) {
        return "";
    }
    match (image.decode_png(original)) {
        Result.Err(_) => "",
        Result.Ok(img) => {
            match (image.encode_png(downscale(img, MAX_SIDE))) {
                Result.Err(_) => "",
                Result.Ok(encoded) => {
                    fs.mkdir(cache_dir).unwrap_or(0);
                    match (fs.write_file_bytes(cached, encoded)) {
                        Result.Ok(_) => cached,
                        Result.Err(_) => "",
                    }
                },
            }
        },
    }
}

/// Downscales an RGBA image so its longest side is at most `max_side`, averaging each
/// source block (a box filter: cheap, and much better than dropping pixels).
pub fn downscale(img: image.Image, max_side: int) -> image.Image {
    let longest: int = if (img.width > img.height) { img.width } else { img.height };
    if (longest <= max_side || img.width <= 0 || img.height <= 0) {
        return img;
    }
    let w: int = at_least_one(img.width * max_side / longest);
    let h: int = at_least_one(img.height * max_side / longest);
    var out: [int] = [];
    var y: int = 0;
    while (y < h) {
        let sy0: int = y * img.height / h;
        let sy1: int = at_least(sy0 + 1, (y + 1) * img.height / h);
        var x: int = 0;
        while (x < w) {
            let sx0: int = x * img.width / w;
            let sx1: int = at_least(sx0 + 1, (x + 1) * img.width / w);
            var r: int = 0;
            var g: int = 0;
            var b: int = 0;
            var a: int = 0;
            var n: int = 0;
            var sy: int = sy0;
            while (sy < sy1) {
                var sx: int = sx0;
                while (sx < sx1) {
                    let at: int = (sy * img.width + sx) * 4;
                    r = r + img.pixels[at];
                    g = g + img.pixels[at + 1];
                    b = b + img.pixels[at + 2];
                    a = a + img.pixels[at + 3];
                    n = n + 1;
                    sx = sx + 1;
                }
                sy = sy + 1;
            }
            if (n == 0) {
                n = 1;
            }
            out.push(r / n);
            out.push(g / n);
            out.push(b / n);
            out.push(a / n);
            x = x + 1;
        }
        y = y + 1;
    }
    image.Image { width: w, height: h, pixels: bytes_of(out) }
}

fn at_least_one(v: int) -> int {
    if (v < 1) { 1 } else { v }
}

fn at_least(floor_value: int, v: int) -> int {
    if (v < floor_value) { floor_value } else { v }
}

@test
fn downscaling_keeps_the_aspect_ratio() {
    let img: image.Image = solid(800, 400, 10, 20, 30);
    let small: image.Image = downscale(img, 400);
    assert_eq(small.width, 400);
    assert_eq(small.height, 200);
    assert_eq(small.pixels.len(), 400 * 200 * 4);
    // Una imagen de color plano sigue siendo del mismo color tras promediar.
    assert_eq(small.pixels[0], 10);
    assert_eq(small.pixels[1], 20);
    assert_eq(small.pixels[2], 30);
    assert_eq(small.pixels[3], 255);
}

@test
fn small_images_are_left_alone() {
    let img: image.Image = solid(100, 50, 1, 2, 3);
    let same: image.Image = downscale(img, 400);
    assert_eq(same.width, 100);
    assert_eq(same.height, 50);
}

@test
fn thumbnails_are_cached_on_disk() {
    let root: string = fs.make_temp_dir("raystream_thumbs").unwrap_or("");
    let img: image.Image = solid(600, 600, 200, 100, 50);
    let png: bytes = image.encode_png(img).unwrap_or(b"");
    fs.write_file_bytes(root + "/big.png", png).unwrap_or(0);
    var it: Item = library.new_item("big.png", Kind.Image, png.len(), 7);

    let cached: string = "${root}/${CACHE_SUBDIR}/${it.id}-7.png";
    match (thumbnail(root, root + "/big.png", it)) {
        Thumb.File(file, mime) => {
            assert_eq(file, cached);
            assert_eq(mime, "image/png");
            let decoded: image.Image = image.decode_png(fs.read_file_bytes(file).unwrap_or(b""))
                .unwrap_or(solid(1, 1, 0, 0, 0));
            assert_eq(decoded.width, MAX_SIDE);
        },
        Thumb.Range(_, _, _, _) => panic("a png is not a range"),
        Thumb.Missing => panic("a png should have a thumbnail"),
    }
    fs.remove_all(root).unwrap_or(0);
}

@test
fn big_or_undecodable_images_are_served_as_they_are() {
    // Un PNG por encima del tope no se decodifica: se sirve el original, sin cargarlo.
    var big: Item = library.new_item("huge.png", Kind.Image, MAX_PNG_DECODE + 1, 1);
    match (thumbnail("/nonexistent", "/lib/huge.png", big)) {
        Thumb.File(file, _) => assert_eq(file, "/lib/huge.png"),
        Thumb.Range(_, _, _, _) => panic("no range for an image"),
        Thumb.Missing => panic("the original is the thumbnail"),
    }
    let gif: Item = library.new_item("anim.gif", Kind.Image, 10, 1);
    match (thumbnail("/nonexistent", "/lib/anim.gif", gif)) {
        Thumb.File(file, mime) => {
            assert_eq(file, "/lib/anim.gif");
            assert_eq(mime, "image/gif");
        },
        Thumb.Range(_, _, _, _) => panic("no range for an image"),
        Thumb.Missing => panic("the original is the thumbnail"),
    }
}

fn solid(w: int, h: int, r: int, g: int, b: int) -> image.Image {
    var px: [int] = [];
    var i: int = 0;
    while (i < w * h) {
        px.push(r);
        px.push(g);
        px.push(b);
        px.push(255);
        i = i + 1;
    }
    image.Image { width: w, height: h, pixels: bytes_of(px) }
}
